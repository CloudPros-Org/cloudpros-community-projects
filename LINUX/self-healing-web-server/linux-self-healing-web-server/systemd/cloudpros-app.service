[Unit]
Description=Deploy web server
After=network.target

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/opt/cloudpros/
ExecStart=/usr/bin/socat TCP-LISTEN:8000,fork,reuseaddr,bind=127.0.0.1 Exec:/opt/cloudpros/cloudpros.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target