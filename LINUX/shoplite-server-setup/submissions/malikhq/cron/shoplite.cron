
# Run the system report every six hours as root.
0 */6 * * * root /usr/local/sbin/sysreport.sh

# Delete only ShopLite report files older than 14 days.
# This does not remove unrelated files or compressed archives.
17 3 * * * root /usr/bin/find /var/log/shoplite -maxdepth 1 -type f -name 'sysreport-*.log' -mtime +14 -delete
