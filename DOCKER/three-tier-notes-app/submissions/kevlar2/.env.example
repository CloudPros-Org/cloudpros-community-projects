# Copy this file to .env and set your own values: cp .env.example .env
# Never commit .env

# PostgreSQL (read by the db container and by the api)
POSTGRES_DB=notes
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=change-me

# Hostname of the database as seen from the api container.
# This is the Compose service name, not an IP address.
POSTGRES_HOST=db
